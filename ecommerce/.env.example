# CCbeauty environment template. Never place real production secrets in Git.

# Environment selection
# development is the safe default; production enables PostgreSQL, R2, and HTTPS.
DJANGO_ENV=development

# Django
# Required in production. Optional in development, which has an explicitly
# insecure local-only fallback.
SECRET_KEY=

# Database
# Optional development override. Leave blank to use ecommerce/db.sqlite3.
SQLITE_PATH=

# Required in production. SUPABASE_DB_* and legacy NAME/USER/PASSWORD/HOST/PORT
# remain supported, but these cleaner names are preferred.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require

# Paystack
# Optional for ordinary local browsing; required in production/payment testing.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Email
# Development uses the console backend unless this is explicitly enabled.
DEVELOPMENT_USE_SMTP=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_TLS=false
SMTP_USE_SSL=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Cloudflare R2
# Required in production and unused in normal development.
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_CUSTOM_DOMAIN=
# Optional; derived from the account ID when blank.
CLOUDFLARE_R2_ENDPOINT_URL=

# Security and allowed hosts
# Comma-separated and required in production. Wildcards are rejected.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Include scheme, for example https://shop.example.com.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

